{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rocky",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // 画面のパス (/words/... など) は index.html を返し、/api だけ Worker で処理する
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rocky",
      "database_id": "b463b734-8376-4a27-a9cb-b15fcd6191d0",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "rocky-audio" }],
  "vars": {
    // Cloudflare Access の設定 (秘密の値ではない)。空にすると API はすべて拒否する
    "ACCESS_TEAM_DOMAIN": "withered-paper-fd3a.cloudflareaccess.com",
    "ACCESS_AUD": "70d7c408452495582efd026856961cd42c45275f6723c5da28abb589a1904590"
  }
}
